# Swift / Xcode build artifacts
.build/
.xcodebuild/
.swiftpm/
DerivedData/
ModelMatrix.xcodeproj/
*.xcuserstate
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/

# Release/build outputs (the web dashboard build in Dashboard/dist is tracked
# so building from source does not need Node.js)
/dist/
*.dmg
*.app/

# Web dashboard dependencies and caches
Dashboard/node_modules/
Dashboard/.vite/
Dashboard/*.tsbuildinfo

# Controller runtime state (machine-local)
Controller/run/
Controller/benchmark-results/
Controller/runtime/
Controller/bin/

# Local model profiles (keep only examples in git)
Controller/model-profiles/*
!Controller/model-profiles/examples/
!Controller/model-profiles/examples/**

# Python caches and virtual envs
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Usage databases, logs and temp files
*.sqlite3
*.sqlite3-*
*.log
*.pid
*.tmp
*.swp
*.swo
*.orig
*.bak

# Sensitive material (certs, keys, local secrets)
*.p8
*.p12
*.pem
*.key
*.cer
*.crt
.env
.env.*

# macOS
.DS_Store
**/.DS_Store

# Windows generated distribution packages
/dist-windows/

# Runtime credentials/state must never enter a public source repository
/secrets/
/run/
/Logs/
/state/
*.token
